+static int dt_probe_neo_ssd(void)
+{
+    int chosen = fdt_path_offset(dt, "/chosen");
+    if (chosen < 0 || fdt_getprop(dt, chosen, "vlinux,ssd-probe", NULL))
+        bail("FDT: Missing chosen or preexisting SSD probe claim\n");
+#ifdef VLINUX_SSD_IDENTIFY_PROBE
+    static char report[NEO_SSD_IDENTIFY_REPORT_SIZE];
+#else
+    static char report[NEO_SSD_REPORT_SIZE];
+#endif
+    memset(report, 0, sizeof(report));
+    if (fdt_setprop(dt, chosen, "vlinux,ssd-probe", report, sizeof(report)))
+        bail("FDT: Cannot reserve SSD report before MMIO\n");
+    printf("SSD: Beginning bounded register probe\n");
+    boot_checkpoint(55);
+#ifdef VLINUX_SSD_IDENTIFY_PROBE
+    if (neo_ssd_probe_queues(report, sizeof(report), chip_id == T8140 &&
+                   fdt_node_check_compatible(dt, 0, "apple,j700") == 0,
+                   neo_ssd_read32_guarded, neo_ssd_write32_guarded, neo_ssd_delay_us)) {
+        if (dt_identify_neo_ssd(report, sizeof(report))) return -1;
+    }
+#elif defined(VLINUX_SSD_QUEUE_PROBE)
+    neo_ssd_probe_queues(report, sizeof(report), chip_id == T8140 &&
+                   fdt_node_check_compatible(dt, 0, "apple,j700") == 0,
+                   neo_ssd_read32_guarded, neo_ssd_write32_guarded, neo_ssd_delay_us);
+#elif defined(VLINUX_SSD_POWER_PROBE)
+    neo_ssd_probe_power(report, sizeof(report), chip_id == T8140 &&
+                   fdt_node_check_compatible(dt, 0, "apple,j700") == 0,
+                   neo_ssd_read32_guarded, neo_ssd_write32_guarded, neo_ssd_delay_us);
+#else
+    neo_ssd_probe(report, sizeof(report), chip_id == T8140 &&
+                   fdt_node_check_compatible(dt, 0, "apple,j700") == 0,
+                   neo_ssd_read32_guarded);
+#endif
+    boot_checkpoint(56);
+    neo_ssd_console_report(report, sizeof(report), false, neo_ssd_console_emit);
+    chosen = fdt_path_offset(dt, "/chosen"); /* Reservations may move node offsets. */
+    if (fdt_setprop(dt, chosen, "vlinux,ssd-probe", report, sizeof(report)))
+        bail("FDT: Cannot record SSD report\n");
+    return 0;
+}
