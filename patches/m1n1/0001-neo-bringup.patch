+/* SPDX-License-Identifier: MIT */
+#ifndef VLINUX_RAM_BOOT_H
+#define VLINUX_RAM_BOOT_H
+#include "types.h"
+
+static inline bool ram_boot_span_valid(u64 base, u64 size, u64 low, u64 len, u64 top)
+{
+    u64 high = low + len;
+    return size && base + size >= base && len && high >= low && low >= base &&
+           high <= base + size && top >= low && top < high;
+}
+
+static inline bool ram_boot_range_disjoint(u64 low, u64 high, u64 base, u64 size)
+{
+    u64 end = base + size;
+    return end >= base && (!size || base >= high || end <= low);
+}
+#endif
