diff --git a/src/entry_probe.h b/src/entry_probe.h
new file mode 100644
index 0000000..7df7211
--- /dev/null
+++ b/src/entry_probe.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ENTRY_PROBE_H
+#define ENTRY_PROBE_H
+
+#include "types.h"
+#include "xnuboot.h"
+
+#define ENTRY_PROBE_X 8
+#define ENTRY_PROBE_Y 8
+#define ENTRY_PROBE_WIDTH 128
+#define ENTRY_PROBE_HEIGHT 32
+
+/* Only touches a small rectangle in an already supplied framebuffer. It does
+ * not configure scanout, map memory, allocate, or access a controller register.
+ * Callers must establish that these are the physical boot framebuffer/DRAM
+ * addresses and arrange cache visibility after painting. */
+static inline bool entry_probe_paint_stage(const struct boot_video *video, u64 dram_base,
+                                           u64 dram_size, unsigned int stage)
+{
+    u64 depth = video->depth & 0xff;
+    if (stage > 99 || !video->base || (video->base & 3) || (video->stride & 3) ||
+        video->width < 160 || video->width > 8192 || video->height < 64 ||
+        video->height > 8192 || video->stride < video->width * 4 ||
+        video->stride > 65536 || (depth != 24 && depth != 30 && depth != 32))
+        return false;
+
+    u64 size = video->stride * video->height;
+    if (!dram_size || dram_base > UINT64_MAX - dram_size || size > 128 * 1024 * 1024 ||
+        video->base < dram_base || video->base - dram_base >= dram_size ||
+        size > dram_size - (video->base - dram_base))
+        return false;
+
+    u32 white = depth == 30 ? 0x3fffffff : 0x00ffffff;
+    for (u32 y = 0; y < ENTRY_PROBE_HEIGHT; y++) {
+        volatile u32 *row = (volatile u32 *)(video->base +
+            (ENTRY_PROBE_Y + y) * video->stride + ENTRY_PROBE_X * 4);
+        /* 3x5 decimal digits, scaled 4x. Stage zero keeps the proven barcode. */
+        static const u16 digits[10] = {
+            0x7b6f, 0x2492, 0x73e7, 0x73cf, 0x5bc9,
+            0x79cf, 0x79ef, 0x7249, 0x7bef, 0x7bcf,
+        };
+        for (u32 x = 0; x < ENTRY_PROBE_WIDTH; x++) {
+            bool lit = y == 0 || y == ENTRY_PROBE_HEIGHT - 1 ||
+                       x == 0 || x == ENTRY_PROBE_WIDTH - 1;
+            if (!stage) {
+                lit |= (x / 16) % 2 == 0;
+            } else if (y >= 6 && y < 26 && x >= 48 && x < 76) {
+                u32 dx = x - 48;
+                if (dx < 12 || dx >= 16) {
+                    unsigned int digit = dx < 12 ? stage / 10 : stage % 10;
+                    unsigned int col = (dx < 12 ? dx : dx - 16) / 4;
+                    unsigned int bit = 14 - ((y - 6) / 4 * 3 + col);
+                    lit |= (digits[digit] >> bit) & 1;
+                }
+            }
+            row[x] = lit ? white : 0;
+        }
+    }
+    return true;
+}
+
+static inline bool entry_probe_paint(const struct boot_video *video, u64 dram_base, u64 dram_size)
+{
+    return entry_probe_paint_stage(video, dram_base, dram_size, 0);
+}
+
+#endif
