+static int dt_identify_neo_ssd(char *report, size_t report_size)
+{
+    u64 heap = (u64)heapblock_alloc_aligned(0, 1);
+    if (heap > ~(u64)0 - NEO_SSD_DMA_ALIGN - NEO_SSD_DMA_SIZE ||
+        heap < cur_boot_args.top_of_kernel_data || (u64)_end < (u64)_base)
+        bail("SSD: Invalid heap bounds before DMA reservation\n");
+    u64 arena = ALIGN_UP(heap, NEO_SSD_DMA_ALIGN);
+    struct neo_ssd_memory memory = {
+        .usable_base = cur_boot_args.phys_base,
+        .usable_size = cur_boot_args.mem_size,
+        .arena = arena,
+        .loaded = {
+            {cur_boot_args.top_of_kernel_data, arena + NEO_SSD_DMA_SIZE - cur_boot_args.top_of_kernel_data},
+            {(u64)initrd_start, initrd_size},
+            {(u64)_base, (u64)_end - (u64)_base},
+        },
+    };
+    if (!neo_ssd_identify_memory(&memory, report, report_size, neo_ssd_read32_guarded))
+        return 0; /* No admin register writes or memory initialization occurred. */
+    /* Reject any existing Linux reservation that intersects the proposed arena.
+     * Do not silently take memory owned by another firmware component. */
+    int parent = fdt_path_offset(dt, "/reserved-memory");
+    if (parent < 0) bail("FDT: Missing reserved-memory for SSD\n");
+    int node;
+    fdt_for_each_subnode(node, dt, parent) {
+        int length = 0;
+        const fdt64_t *reg = fdt_getprop(dt, node, "reg", &length);
+        if (!reg) continue;
+        if (length <= 0 || length % 16) bail("FDT: Invalid existing reservation\n");
+        for (int i = 0; i < length / 8; i += 2) {
+            u64 start = fdt64_to_cpu(reg[i]), size = fdt64_to_cpu(reg[i+1]);
+            if (!size || start + size < start ||
+                (start < arena + NEO_SSD_DMA_SIZE && arena < start + size))
+                bail("FDT: Existing reservation overlaps SSD arena\n");
+        }
+    }
+    for (int i = 0; i < fdt_num_mem_rsv(dt); i++) {
+        u64 start, size;
+        if (fdt_get_mem_rsv(dt, i, &start, &size) || start + size < start ||
+            (start < arena + NEO_SSD_DMA_SIZE && arena < start + size))
+            bail("FDT: Existing memory reserve overlaps SSD arena\n");
+    }
+    for (unsigned int i = 0; i < memory.count; i++)
+        if (dt_neo_ssd_reserve_one(memory.keep[i].start, memory.keep[i].size, "vlinux-ans-keep"))
+            return -1;
+    if (dt_neo_ssd_reserve_one(arena, NEO_SSD_DMA_SIZE, "vlinux-ssd-dma") ||
+        fdt_add_mem_rsv(dt, arena, NEO_SSD_DMA_SIZE))
+        bail("FDT: Could not retain the private SSD arena\n");
+    void *cpu = heapblock_alloc_aligned(NEO_SSD_DMA_SIZE, NEO_SSD_DMA_ALIGN);
+    if ((u64)cpu != arena) bail("SSD: Allocator changed after memory planning\n");
+    printf("SSD: Firmware regions and private DMA arena reserved at 0x%lx\n", arena);
+#ifdef VLINUX_SSD_FIRMWARE_PROBE
+#ifdef VLINUX_SSD_BUFFER_PROBE
+    static const struct neo_ssd_buffer_ops ops = {
+        .mailbox = {neo_ssd_read32_guarded, neo_ssd_firmware_read64_guarded,
+                    neo_ssd_firmware_write64_guarded, neo_ssd_delay_us, neo_ssd_firmware_stage},
+        .write32 = neo_ssd_sart_write32_guarded,
+        .prepare = neo_ssd_buffer_prepare,
+    };
+    neo_ssd_reserved_arena = arena;
+    unsigned int checkpoint = neo_ssd_buffers_probe(arena, report, report_size, &ops);
+#else
+    static const struct neo_ssd_firmware_ops ops = {
+        neo_ssd_read32_guarded, neo_ssd_firmware_read64_guarded,
+        neo_ssd_firmware_write64_guarded, neo_ssd_delay_us, neo_ssd_firmware_stage,
+    };
+    neo_ssd_reserved_arena = arena;
+#ifdef VLINUX_SSD_SERVICE_PROBE
+    unsigned int checkpoint = neo_ssd_services_probe(report, report_size, &ops);
+#else
+    unsigned int checkpoint = neo_ssd_firmware_probe(report, report_size, &ops);
+#endif
+#endif
+    neo_ssd_reserved_arena = 0;
+    neo_ssd_console_report(report, report_size, true, neo_ssd_console_emit);
+    printf("SSD: Firmware probe hold at %u. Photograph screen; power off manually.\n", checkpoint);
+    /* Even a completed map is not a full RTKit boot. No admin writes or Linux
+     * handoff: retain all firmware memory while the negotiated IOP is active. */
+    while (true) sysop("wfe");
+#else
+    static const struct neo_ssd_admin_ops ops = {
+        neo_ssd_read32_guarded, neo_ssd_admin_write32_guarded, neo_ssd_delay_us,
+        neo_ssd_dma_rmb, neo_ssd_dma_wmb, neo_ssd_admin_stage,
+    };
+    neo_ssd_reserved_arena = arena;
+    enum neo_ssd_admin_result result = neo_ssd_identify(cpu, arena, report, report_size, &ops);
+    neo_ssd_reserved_arena = 0;
+    if (result == NEO_SSD_ADMIN_HOLD) {
+        neo_ssd_console_report(report, report_size, true, neo_ssd_console_emit);
+        printf("SSD: Holding at 62. Photograph this screen; power off manually.\n");
+        /* No Linux handoff or allocator reuse when DMA ownership is uncertain.
+         * WDTs are already disabled by the native-tested initialization path. */
+        while (true) sysop("wfe");
+    }
+#endif
+    return 0;
+}
+#endif
