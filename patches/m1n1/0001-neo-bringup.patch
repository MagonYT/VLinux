+#ifdef VLINUX_RAM_BOOT
+static int dt_prepare_neo_mtp_dapf(void)
+{
+    if (fdt_node_check_compatible(dt, 0, "apple,t8140") != 0)
+        return 0;
+
+    int helper = fdt_node_offset_by_compatible(dt, -1, "apple,t8140-mtp");
+    if (helper < 0 || !fdt_getprop(dt, helper, "apple,mtp-preserve-firmware", NULL))
+        return 0;
+    if (fdt_path_offset(dt, "mtp") != helper)
+        bail("FDT: MTP DAPF setup requires the mtp alias\n");
+
+    int len;
+    const char *enabled = fdt_getprop(dt, helper, "status", &len);
+    if (enabled && !((len == 5 && !memcmp(enabled, "okay", 5)) ||
+                     (len == 3 && !memcmp(enabled, "ok", 3))))
+        return 0;
+
+    int chosen = fdt_path_offset(dt, "/chosen");
+    if (chosen < 0)
+        bail("FDT: Missing chosen node for MTP DAPF diagnostics\n");
+    if (fdt_getprop(dt, chosen, "vlinux,mtp-dapf-status", NULL))
+        bail("FDT: Refusing a preexisting MTP DAPF success claim\n");
+
+    /* Allocate the diagnostic property before touching MMIO. Its size stays
+     * fixed so recording verified readback needs no further FDT space.
+     */
+    char status[64] = "pending";
+    if (fdt_setprop(dt, chosen, "vlinux,mtp-dapf-status", status, sizeof(status)))
+        bail("FDT: Cannot reserve MTP DAPF diagnostic property\n");
+
+    int count = dapf_init_neo_mtp();
+    if (count <= 0)
+        bail("FDT: Neo MTP DAPF setup/readback failed; stopping handoff\n");
+    memset(status, 0, sizeof(status));
+    snprintf(status, sizeof(status), "verified entries=%d", count);
+    if (fdt_setprop(dt, chosen, "vlinux,mtp-dapf-status", status, sizeof(status)))
+        bail("FDT: Cannot record verified MTP DAPF setup\n");
+    return 0;
+}
