+static int dt_neo_ssd_reserve_one(u64 start, u64 size, const char *prefix)
+{
+    int parent = fdt_path_offset(dt, "/reserved-memory");
+    char name[64];
+    snprintf(name, sizeof(name), "%s@%lx", prefix, start);
+    if (parent < 0 || fdt_subnode_offset(dt, parent, name) != -FDT_ERR_NOTFOUND)
+        bail("FDT: Missing reserved-memory or preexisting SSD reservation\n");
+    if (dt_get_or_add_reserved_mem(name, "vlinux,ans-diagnostic-memory", true, start, size) < 0)
+        bail("FDT: Cannot reserve SSD diagnostic memory\n");
+    return 0;
+}
