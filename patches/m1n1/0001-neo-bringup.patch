diff --git a/src/boot_trace.h b/src/boot_trace.h
new file mode 100644
index 0000000..07f4b7f
--- /dev/null
+++ b/src/boot_trace.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef BOOT_TRACE_H
+#define BOOT_TRACE_H
+#include "../build/build_cfg.h"
+#if defined(VLINUX_ENTRY_PROBE) && defined(VLINUX_BOOT_TRACE)
+#error "ENTRY_PROBE and BOOT_TRACE are separate diagnostics"
+#endif
+#if defined(VLINUX_MMU_TRACE) && !defined(VLINUX_BOOT_TRACE)
+#error "MMU_TRACE requires BOOT_TRACE=1"
+#endif
+#if defined(VLINUX_INIT_TRACE) && !defined(VLINUX_MMU_TRACE)
+#error "INIT_TRACE requires MMU_TRACE=1 and BOOT_TRACE=1"
+#endif
+#if defined(VLINUX_RAM_BOOT) && !defined(VLINUX_INIT_TRACE)
+#error "RAM_BOOT requires INIT_TRACE=1, MMU_TRACE=1 and BOOT_TRACE=1"
+#endif
+#if defined(VLINUX_HANDOFF_TRACE) && !defined(VLINUX_RAM_BOOT)
+#error "HANDOFF_TRACE requires RAM_BOOT=1 and its trace dependencies"
+#endif
+#ifdef VLINUX_INIT_TRACE
+void boot_trace_refresh(void);
+#else
+static inline void boot_trace_refresh(void) {}
+#endif
+#ifdef VLINUX_BOOT_TRACE
+void boot_checkpoint(unsigned int stage);
+__attribute__((noreturn)) void boot_trace_hold(void);
+#else
+static inline void boot_checkpoint(unsigned int stage) { (void)stage; }
+#endif
+static inline void mmu_checkpoint(unsigned int stage)
+{
+#ifdef VLINUX_MMU_TRACE
+    boot_checkpoint(stage);
+#else
+    (void)stage;
+#endif
+}
+#endif
diff --git a/src/dapf.c b/src/dapf.c
index 3b4b773..33524da 100644
--- a/src/dapf.c
+++ b/src/dapf.c
@@ -69,6 +69,121 @@ struct dapf_t8110b_config {
     u32 pad;
 } PACKED;
 
+#define NEO_MTP_DAPF_COUNT  10
+#define NEO_MTP_DAPF_STRIDE 0x40
+#define NEO_MTP_DAPF_LOCK   BIT(2)
+
+/* SPTM compares only implemented address, SID and control bits. */
+static bool dapf_neo_mtp_matches(u64 base, const struct dapf_t8110_config *config, bool report)
+{
+    const u32 offsets[] = {0x08, 0x0c, 0x10, 0x14, 0x20, 0x00};
+    const u32 masks[] = {0xfffffffc, 0xf, 0xfffffffc, 0xf, 0xffff, 0x333};
+    bool matches = true;
+
+    for (unsigned i = 0; i < NEO_MTP_DAPF_COUNT; i++) {
+        const u32 values[] = {(u32)config[i].start, config[i].start >> 32,
+                             (u32)config[i].end,   config[i].end >> 32,
+                             config[i].r20,       0x31};
+        for (unsigned j = 0; j < ARRAY_SIZE(offsets); j++) {
+            u32 value = read32(base + i * NEO_MTP_DAPF_STRIDE + offsets[j]);
+            if ((value & masks[j]) != (values[j] & masks[j])) {
+                matches = false;
+                if (report)
+                    printf("dapf: Neo MTP entry %u +0x%x: read %08x expected %08x mask %08x\n", i,
+                           offsets[j], value, values[j], masks[j]);
+            }
+        }
+    }
+
+    return matches;
+}
+
+/*
+ * Restore only the observed Neo MTP filter schema. No DART/TCR, other DAPF,
+ * clock, or lock state is changed here. The caller must abort handoff on error.
+ */
+int dapf_init_neo_mtp(void)
+{
+    const char *path = "/arm-io/dart-mtp";
+    struct dapf_t8110_config config[NEO_MTP_DAPF_COUNT];
+    int dart_path[8];
+    u64 dart_base, dart_size, dapf_base, dapf_size;
+    u32 length;
+    int node = adt_path_offset_trace(adt, path, dart_path);
+
+    if (node < 0 || !adt_is_compatible(adt, node, "dart,t8110")) {
+        printf("dapf: Neo MTP node/compatible missing\n");
+        return -1;
+    }
+    if (adt_get_reg(adt, dart_path, "reg", 0, &dart_base, &dart_size) < 0 ||
+        adt_get_reg(adt, dart_path, "reg", 1, &dapf_base, &dapf_size) < 0 ||
+        dart_base != 0x314800000 || dart_size < 0xc000 || dapf_base != 0x314810000 ||
+        dapf_size != 0x4000) {
+        printf("dapf: Neo MTP register layout differs from verified hardware\n");
+        return -1;
+    }
+
+    const void *property = adt_getprop(adt, node, "dapf-instance-0", &length);
+    if (!property || sizeof(struct dapf_t8110_config) != 52 || length != sizeof(config) ||
+        NEO_MTP_DAPF_COUNT > dapf_size / NEO_MTP_DAPF_STRIDE) {
+        printf("dapf: Neo MTP requires the verified 10 x 52-byte descriptor schema\n");
+        return -1;
+    }
+    memcpy(config, property, sizeof(config));
+
+    /* Validate every descriptor before even reading the DAPF registers. */
+    for (unsigned i = 0; i < ARRAY_SIZE(config); i++) {
+        const struct dapf_t8110_config *c = &config[i];
+        bool unknown = c->unk1 || c->unk3 || c->unk4;
+        for (unsigned j = 0; j < ARRAY_SIZE(c->unk2); j++)
+            unknown |= c->unk2[j] != 0;
+
+        /* DAPF address readback exposes 36 bits, independently of DART IAS. */
+        if (!c->start || c->start > c->end || c->end >= BIT(36) || !ram_base || c->end >= ram_base ||
+            c->r20 != 1 || c->r4 != 0 || c->r0_hi != 3 || c->r0_lo != 1 || unknown) {
+            printf("dapf: Neo MTP descriptor %u differs from verified schema\n", i);
+            return -1;
+        }
+    }
+
+    u32 protect = read32(dart_base + 0x200);
+    u32 protect_lock = read32(dart_base + 0x208);
+    printf("dapf: Neo MTP PROTECT=%08x PROTECT_LOCK=%08x\n", protect, protect_lock);
+    if (dapf_neo_mtp_matches(dapf_base, config, false)) {
+        printf("dapf: Neo MTP verified %u existing entries, no writes\n", NEO_MTP_DAPF_COUNT);
+        return NEO_MTP_DAPF_COUNT;
+    }
+    /* Be conservative even when only one of the two protection bits is set. */
+    if ((protect | protect_lock) & NEO_MTP_DAPF_LOCK) {
+        printf("dapf: Neo MTP locked configuration does not match ADT; refusing writes\n");
+        return -1;
+    }
+
+    for (unsigned i = 0; i < ARRAY_SIZE(config); i++) {
+        u64 base = dapf_base + i * NEO_MTP_DAPF_STRIDE;
+        /* +4 has no recovered SPTM writer: preserve it, even though ADT r4=0. */
+        printf("dapf: Neo MTP entry %u %lx..%lx SID=%x control=31 preserved+4=%08x\n", i,
+               config[i].start, config[i].end, config[i].r20, read32(base + 4));
+        write32(base + 0x08, config[i].start);
+        write32(base + 0x0c, config[i].start >> 32);
+        write32(base + 0x10, config[i].end);
+        write32(base + 0x14, config[i].end >> 32);
+        write32(base + 0x20, config[i].r20);
+    }
+    dma_wmb();
+    for (unsigned i = 0; i < ARRAY_SIZE(config); i++)
+        write32(dapf_base + i * NEO_MTP_DAPF_STRIDE, 0x31);
+
+    sysop("dsb sy");
+    /* Readback both flushes posted writes and checks every programmed field. */
+    if (!dapf_neo_mtp_matches(dapf_base, config, true)) {
+        printf("dapf: Neo MTP readback failed; abort handoff\n");
+        return -1;
+    }
+    printf("dapf: Neo MTP restored and verified %u entries\n", NEO_MTP_DAPF_COUNT);
+    return NEO_MTP_DAPF_COUNT;
+}
+
 static int dapf_init_t8110a(u64 base, struct dapf_t8110_config *config, u32 length)
 {
     int count = length / sizeof(*config);
