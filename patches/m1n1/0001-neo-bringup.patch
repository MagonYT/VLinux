@@ -3,6 +3,21 @@
 #ifndef XNUBOOT_H
 #define XNUBOOT_H
 
+#include "types.h"
+
+static inline bool boot_mem_size_from_range(u64 dram_base, u64 phys_base, u64 usable_size,
+                                            u64 *size)
+{
+    const u64 rounding = (1UL << 30) - 1;
+    if (!usable_size || phys_base < dram_base || usable_size > UINT64_MAX - phys_base)
+        return false;
+    u64 span = phys_base + usable_size - dram_base;
+    if (span > UINT64_MAX - rounding)
+        return false;
+    *size = (span + rounding) & ~rounding;
+    return true;
+}
