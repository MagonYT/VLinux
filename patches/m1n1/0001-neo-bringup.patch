@@ -1517,6 +1520,524 @@ static int dt_device_add_mem_region(const char *alias, uint32_t phandle, const c
     return 0;
 }
 
+static int dt_reserve_mtp_dram(void)
+{
+    int helper = fdt_node_offset_by_compatible(dt, -1, "apple,t8140-mtp");
+    if (helper < 0 || !fdt_getprop(dt, helper, "apple,mtp-preserve-firmware", NULL))
+        return 0;
+    if (fdt_path_offset(dt, "mtp") != helper)
+        bail("FDT: MTP memory opt-in requires the mtp alias\n");
+    if (fdt_getprop(dt, helper, "memory-region", NULL))
+        bail("FDT: MTP already has static memory-region entries\n");
+
+    int chosen = adt_path_offset(adt, "/chosen");
+    u64 dram_base, dram_size;
+    if (chosen < 0 || ADT_GETPROP(adt, chosen, "dram-base", &dram_base) < 0 ||
+        ADT_GETPROP(adt, chosen, "dram-size", &dram_size) < 0 || !dram_size ||
+        dram_base + dram_size < dram_base)
+        bail("ADT: Missing or invalid DRAM bounds for MTP reservations\n");
+    u64 dram_end = dram_base + dram_size;
+
+    int anode = adt_path_offset(adt, "/arm-io/mtp/iop-mtp-nub");
+    if (anode < 0)
+        bail("ADT: MTP firmware node not found\n");
+
+    u32 preloaded = 0;
+    if (ADT_GETPROP(adt, anode, "pre-loaded", &preloaded) < 0 || preloaded != 1)
+        bail("ADT: MTP runtime firmware is not marked pre-loaded\n");
+
+    u32 length = 0;
+    const struct adt_segment_ranges *segments =
+        adt_getprop(adt, anode, "segment-ranges", &length);
+    if (!segments || !length || length % sizeof(*segments) ||
+        length / sizeof(*segments) > 16)
+        bail("ADT: Invalid MTP segment-ranges\n");
+
+    /* The kernel and initrd are loaded before FDT preparation. Reserving their
+     * pages now would not restore firmware data already overwritten by loading.
+     * Also reject page-sharing: Linux and firmware must not own one 16 KiB page.
+     */
+    u64 heap_start = cur_boot_args.top_of_kernel_data;
+    u64 heap_end = (u64)heapblock_alloc_aligned(0, 1);
+    u64 initrd_begin = (u64)initrd_start;
+    u64 initrd_end = initrd_begin + initrd_size;
+    if (heap_end < heap_start || (u64)_end < (u64)_base ||
+        (initrd_size && (!initrd_begin || initrd_end < initrd_begin)))
+        bail("FDT: Invalid loaded-memory bounds for MTP preservation\n");
+    const struct {
+        u64 start;
+        u64 end;
+        const char *name;
+    } loaded[] = {
+        {heap_start, heap_end, "payload heap"},
+        {initrd_begin, initrd_end, "initrd"},
+        {(u64)_base, (u64)_end, "m1n1"},
+    };
+
+    struct {
+        u64 start;
+        u64 end;
+    } ranges[16];
+    unsigned int count = 0;
+
+    for (unsigned int i = 0; i < length / sizeof(*segments); i++) {
+        const struct adt_segment_ranges *seg = &segments[i];
+        if (!seg->size || seg->phys + seg->size < seg->phys)
+            bail("ADT: Invalid MTP segment %u physical range\n", i);
+        u64 end = seg->phys + seg->size;
+        if (end <= dram_base || seg->phys >= dram_end)
+            continue; /* Local coprocessor SRAM is not Linux DRAM. */
+        if (seg->phys < dram_base || end > dram_end || end > ~(u64)0 - (SZ_16K - 1))
+            bail("ADT: MTP segment %u crosses DRAM boundary\n", i);
+        u64 start = ALIGN_DOWN(seg->phys, SZ_16K);
+        end = ALIGN_UP(end, SZ_16K);
+        if (start < dram_base || end > dram_end)
+            bail("ADT: MTP page-rounded segment %u crosses DRAM boundary\n", i);
+        for (unsigned int j = 0; j < ARRAY_SIZE(loaded); j++) {
+            if (loaded[j].start < loaded[j].end && start < loaded[j].end &&
+                loaded[j].start < end)
+                bail("FDT: MTP segment %u (0x%lx..0x%lx) overlaps %s (0x%lx..0x%lx); "
+                     "refusing Linux handoff\n", i, start, end, loaded[j].name,
+                     loaded[j].start, loaded[j].end);
+        }
+        ranges[count].start = start;
+        ranges[count++].end = end;
+    }
+
+    if (!count)
+        bail("ADT: MTP has no DRAM firmware segments to preserve\n");
+
+    /* Sort and coalesce page-rounded segments; adjacent raw segments may share
+     * a 16 KiB page and must not become overlapping reserved-memory resources.
+     */
+    for (unsigned int i = 1; i < count; i++) {
+        unsigned int j = i;
+        while (j && ranges[j - 1].start > ranges[j].start) {
+            u64 start = ranges[j - 1].start, end = ranges[j - 1].end;
+            ranges[j - 1] = ranges[j];
+            ranges[j].start = start;
+            ranges[j].end = end;
+            j--;
+        }
+    }
+    for (unsigned int i = 0; i < count; i++) {
+        u64 start = ranges[i].start, end = ranges[i].end;
+        while (i + 1 < count && ranges[i + 1].start <= end) {
+            i++;
+            end = max(end, ranges[i].end);
+        }
+        char name[64];
+        snprintf(name, sizeof(name), "mtp-firmware@%lx", start);
+        int node = dt_get_or_add_reserved_mem(name, "apple,asc-mem", true,
+                                               start, end - start);
+        if (node < 0)
+            return node;
+        u32 phandle = fdt_get_phandle(dt, node);
+        if (!phandle)
+            bail("FDT: Missing MTP reserved-memory phandle\n");
+        if (dt_device_add_mem_region("mtp", phandle, NULL))
+            return -1;
+        /* Deliberately no iommu-addresses: physical preservation is established,
+         * but no source yet establishes the corresponding DART-visible address.
+         */
+        printf("FDT: Preserved MTP DRAM 0x%lx..0x%lx (no DART mapping)\n", start, end);
+    }
+    return 0;
+}
