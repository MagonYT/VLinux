+static bool neo_ssd_read32_guarded(u64 address, u32 *value)
+{
+    /* Never nest guards or mask asynchronous abort delivery. One explicit LDR
+     * makes GUARD_MARK's destination-register recovery unambiguous.
+     */
+    if (exc_guard != GUARD_OFF || (mrs(DAIF) & BIT(8)))
+        return false;
+    exc_guard = GUARD_MARK | GUARD_SILENT;
+    int before = exc_count;
+    sysop("dsb sy");
+    sysop("isb");
+    if (exc_count != before) {
+        exc_guard = GUARD_OFF;
+        return false;
+    }
+    u32 data = read32(address);
+    sysop("dsb sy");
+    sysop("isb");
+    bool ok = exc_count == before;
+    exc_guard = GUARD_OFF;
+    if (ok)
+        *value = data;
+    return ok;
+}
+
+#ifdef VLINUX_SSD_POWER_PROBE
+static bool neo_ssd_write32_guarded(u64 address, u32 value)
+{
+    /* Independent closed write allowlist, even if the policy caller changes. */
+    if (address != 0x3007003a0 || value != 0xf || exc_guard != GUARD_OFF ||
+        (mrs(DAIF) & BIT(8)))
+        return false;
+    exc_guard = GUARD_SKIP | GUARD_SILENT;
+    int before = exc_count;
+    sysop("dsb sy");
+    sysop("isb");
+    if (exc_count != before) {
+        exc_guard = GUARD_OFF;
+        return false;
+    }
+    write32(address, value);
+    sysop("dsb sy");
+    sysop("isb");
+    bool ok = exc_count == before;
+    exc_guard = GUARD_OFF;
+    return ok;
+}
