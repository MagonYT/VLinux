+static int dchid_neo_upload_firmware(struct dchid_iface *iface)
+{
+	const struct firmware *fw;
+	u8 msg[16] = { CMD_SEND_FIRMWARE, 2, 0, 1 };
+	int ret;
+
+	ret = request_firmware(&fw, NEO_TRACKPAD_FW_NAME, iface->dchid->dev);
+	if (ret)
+		return ret;
+	ret = dchid_neo_firmware_valid(fw);
+	if (ret)
+		goto release;
+	iface->neo_firmware = dmam_alloc_coherent(iface->dchid->dev, NEO_TRACKPAD_FW_SIZE,
+						 &iface->neo_firmware_dma, GFP_KERNEL);
+	if (!iface->neo_firmware) {
+		ret = -ENOMEM;
+		goto release;
+	}
+	memcpy(iface->neo_firmware, fw->data + NEO_TRACKPAD_FW_HEADER, NEO_TRACKPAD_FW_SIZE);
+	((u8 *)iface->neo_firmware)[NEO_TRACKPAD_FW_IFACE_OFFSET] = iface->index;
+	put_unaligned_le64(iface->neo_firmware_dma, msg + 4);
+	put_unaligned_le32(NEO_TRACKPAD_FW_SIZE, msg + 12);
+	/* Retain this one buffer even if the ACK is lost: the peer may own it. */
+	wmb();
+	dev_info(iface->dchid->dev, "Neo trackpad firmware DMA=%pad bytes=%u\n",
+		 &iface->neo_firmware_dma, NEO_TRACKPAD_FW_SIZE);
+	ret = dchid_neo_trackpad_cmd(iface, msg, sizeof(msg));
+	if (!ret)
+		dev_info(iface->dchid->dev, "Neo trackpad firmware registration acknowledged\n");
+release:
+	release_firmware(fw);
+	return ret;
+}
