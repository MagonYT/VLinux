+static int dchid_neo_trackpad_start(struct dchid_iface *iface)
+{
+	struct apple_smc *smc;
+	int ret;
+
+	mutex_lock(&iface->neo_start_mutex);
+	if (iface->neo_upload_attempted) {
+		ret = iface->neo_upload_error;
+		goto out;
+	}
+	if (iface->index != 1) {
+		ret = -EINVAL;
+		goto out;
+	}
+	/* Acquire only for the trackpad: an SMC failure must not block keyboard probe. */
+	smc = devm_apple_smc_neo_trackpad_get(iface->dchid->dev, iface->of_node);
+	if (IS_ERR(smc)) {
+		ret = PTR_ERR(smc);
+		dev_warn_ratelimited(iface->dchid->dev,
+			"Neo trackpad SMC unavailable: %d; no firmware/power operation\n", ret);
+		goto out;
+	}
+	iface->neo_smc = smc;
+	iface->neo_upload_attempted = true;
+	iface->starting = true;
