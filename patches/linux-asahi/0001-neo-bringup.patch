+static int dchid_neo_trackpad_power(struct dchid_iface *iface, bool on)
+{
+	u8 state = on ? 2 : 0;
+	u8 msg[9] = { CMD_RESET_INTERFACE, 2, 1, state, 0 };
+	u32 host_status = 0;
+	int ret, ack_ret;
+
+	/* Version 2 is WILL -> real host operation -> HAS with its result. */
+	ret = dchid_neo_trackpad_cmd(iface, msg, sizeof(msg));
+	if (ret)
+		return ret;
+	dev_info(iface->dchid->dev, "Neo trackpad WILL state=%u acknowledged\n", state);
+	ret = apple_smc_neo_trackpad_power(iface->neo_smc, on);
+	if (ret)
+		host_status = ret == -ENOENT ? 0xe00002f0 : 0xe00002e9;
+	/* The guarded provider includes J700's 50 ms delay after power off. */
+	dev_info(iface->dchid->dev, "Neo trackpad host power state=%u result=%d\n", state, ret);
+	msg[4] = 1;
+	put_unaligned_le32(host_status, msg + 5);
+	ack_ret = dchid_neo_trackpad_cmd(iface, msg, sizeof(msg));
+	if (!ack_ret)
+		dev_info(iface->dchid->dev, "Neo trackpad HAS state=%u status=%08x acknowledged\n",
+			 state, host_status);
+	return ret ? ret : ack_ret;
+}
