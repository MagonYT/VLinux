+static int apple_smc_neo_metadata_locked(struct apple_smc *smc)
+{
+	static const struct {
+		smc_key key;
+		u8 size;
+		u32 type;
+		u8 flags;
+	} expected[] = {
+		{ SMC_KEY(pcIO), 8, _SMC_KEY("hex_"), 0xf0 },
+		{ SMC_KEY(pmIP), 1, _SMC_KEY("flag"), 0x50 },
+	};
+	u8 info[6];
+	unsigned int i;
+	int ret;
+
+	lockdep_assert_held(&smc->mutex);
+	for (i = 0; i < ARRAY_SIZE(expected); i++) {
+		ret = apple_smc_cmd_locked(smc, SMC_MSG_GET_KEY_INFO,
+					   expected[i].key, 0, 0, NULL);
+		if (ret < 0)
+			return ret;
+		memcpy_fromio(info, smc->shmem.iomem, sizeof(info));
+		if (info[0] != expected[i].size ||
+		    get_unaligned_be32(info + 1) != expected[i].type ||
+		    info[5] != expected[i].flags) {
+			dev_err(smc->dev, "Neo SMC metadata mismatch for key 0x%08x\n",
+				expected[i].key);
+			WRITE_ONCE(smc->neo_failed, true);
