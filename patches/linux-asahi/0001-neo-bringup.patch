+
+static int apple_dart_t8110_v2_pending(struct apple_dart *dart, u32 *pending)
+{
+	unsigned int words = BITS_TO_U32(dart->num_streams);
+
+	for (unsigned int i = 0; i < words; i++) {
+		u32 valid = U32_MAX;
+
+		if (i == words - 1 && dart->num_streams % 32)
+			valid = BIT(dart->num_streams % 32) - 1;
+		pending[i] = readl(dart->regs + DART_T8110_V2_ERROR_PENDING + 4 * i);
+		if (pending[i] & ~valid) {
+			dev_err(dart->dev, "Neo DART pending bits outside implemented SIDs: word %u=%08x\n",
+				i, pending[i]);
+			return -EINVAL;
+		}
+	}
+	return 0;
+}
+
+static int apple_dart_t8110_v2_ack_faults(struct apple_dart *dart,
