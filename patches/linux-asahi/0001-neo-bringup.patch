+static int apple_smc_neo_validate(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct resource *asc, *sram;
+	struct property *prop;
+
+	prop = of_find_property(np, "apple,neo-trackpad-power", NULL);
+	if (!of_device_is_compatible(np, "apple,t8140-smc") ||
+	    !prop || prop->length || of_get_child_count(np) ||
+	    of_property_count_strings(np, "compatible") != 1)
+		return -EINVAL;
+	asc = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	sram = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!asc || !sram || platform_get_resource(pdev, IORESOURCE_MEM, 2) ||
+	    asc->start != 0x30c600000ULL || resource_size(asc) != 0x4000 ||
+	    sram->start != 0x30de00000ULL || resource_size(sram) != 0x100000)
+		return -EINVAL;
+	return 0;
+}
