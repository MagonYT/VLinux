diff --git a/.host_include/vlinux_cpio_compat.h b/.host_include/vlinux_cpio_compat.h
new file mode 100644
index 0000000000000000000000000000000000000000..f53032537ab2c4448eee13f1d9e27492345a64cc
--- /dev/null
+++ b/.host_include/vlinux_cpio_compat.h
@@ -0,0 +1,26 @@
+/* VLinux: macOS host-build compat shim for usr/gen_init_cpio.c
+ *
+ * Two Linux-only APIs are used by this host tool:
+ *
+ *  - copy_file_range(2): Linux-specific. gen_init_cpio already treats a
+ *    short/failed copy as non-fatal and falls back to a read()/write() loop
+ *    ("short or failed copy falls back to read/write..."), so forcing it to
+ *    fail is correct and simply always takes the portable path.
+ *
+ *  - O_LARGEFILE: Linux-specific. macOS uses a 64-bit off_t unconditionally,
+ *    so the flag is a no-op and 0 is the correct value.
+ */
+#ifndef _VLINUX_CPIO_COMPAT_H
+#define _VLINUX_CPIO_COMPAT_H
+
+#ifdef __APPLE__
+
+#ifndef O_LARGEFILE
+#define O_LARGEFILE 0
+#endif
+
+/* Always fail -> gen_init_cpio uses its own read()/write() fallback loop. */
+#define copy_file_range(fd_in, off_in, fd_out, off_out, len, flags) ((ssize_t)-1)
+
+#endif /* __APPLE__ */
+#endif /* _VLINUX_CPIO_COMPAT_H */
