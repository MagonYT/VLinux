diff --git a/drivers/hid/dockchannel-hid/hid-neo-trackpad.c b/drivers/hid/dockchannel-hid/hid-neo-trackpad.c
new file mode 100644
index 0000000000000000000000000000000000000000..f55a66f95092d8c4c75e04ff61727ffa168d160e
--- /dev/null
+++ b/drivers/hid/dockchannel-hid/hid-neo-trackpad.c
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* J700 MTP report75 decoder. Firmware/power remains owned by DockChannel. */
+#include <linux/hid.h>
+#include <linux/input/mt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/workqueue.h>
+#include "neo-trackpad.h"
+
+struct neo_trackpad {
+	struct hid_device *hdev;
+	struct work_struct start_work;
+	struct input_dev *input;
+	struct input_mt_pos positions[NEO_TRACKPAD_CONTACTS];
+	int slots[NEO_TRACKPAD_CONTACTS];
+	bool registered;
+	bool opened;
+	bool layout_logged;
+};
+
+static int neo_trackpad_raw_event(struct hid_device *hdev, struct hid_report *report,
+				 u8 *data, int size)
+{
+	struct neo_trackpad *tp = hid_get_drvdata(hdev);
+	struct neo_tp_frame frame;
+	unsigned int i;
+	int ret;
+
+	if (size <= 0 || data[0] != NEO_TRACKPAD_REPORT || !smp_load_acquire(&tp->registered))
+		return 0;
+	ret = neo_tp_parse_frame(data, size, &frame);
+	if (ret) {
+		hid_warn_ratelimited(hdev, "Neo trackpad rejected report75 layout (bytes=%d)\n", size);
+		return ret;
+	}
+	for (i = 0; i < frame.active; i++) {
+		tp->positions[i].x = frame.contacts[i].x;
+		tp->positions[i].y = frame.contacts[i].y;
+	}
+	ret = input_mt_assign_slots(tp->input, tp->slots, tp->positions, frame.active, 0);
+	if (ret)
+		return ret;
+	for (i = 0; i < frame.active; i++) {
+		input_mt_slot(tp->input, tp->slots[i]);
+		input_mt_report_slot_state(tp->input, MT_TOOL_FINGER, true);
+		input_report_abs(tp->input, ABS_MT_POSITION_X, frame.contacts[i].x);
+		input_report_abs(tp->input, ABS_MT_POSITION_Y, frame.contacts[i].y);
+		input_report_abs(tp->input, ABS_MT_TOUCH_MAJOR, frame.contacts[i].major);
+		input_report_abs(tp->input, ABS_MT_TOUCH_MINOR, frame.contacts[i].minor);
+	}
+	input_mt_sync_frame(tp->input);
+	input_report_key(tp->input, BTN_LEFT, frame.buttons);
+	input_sync(tp->input);
+	if (!tp->layout_logged) {
+		hid_info(hdev, "Neo trackpad decoded report75: bytes=%d offset=%u stride=%u contacts=%u active=%u; input emitted\n",
+			 size, frame.offset, frame.stride, frame.count, frame.active);
+		tp->layout_logged = true;
+	}
+	return 1;
+}
+
+static void neo_trackpad_start_work(struct work_struct *work)
+{
+	struct neo_trackpad *tp = container_of(work, struct neo_trackpad, start_work);
+	struct hid_device *hdev = tp->hdev;
+	struct neo_tp_dimensions dim;
+	struct input_dev *input;
+	u8 dimensions[17] = { NEO_TRACKPAD_DIMENSIONS };
+	int ret;
+
+	ret = hid_hw_open(hdev);
+	if (ret) {
+		hid_err(hdev, "Neo trackpad decoder startup failed: %d\n", ret);
+		return;
+	}
+	tp->opened = true;
+	ret = hid_hw_raw_request(hdev, NEO_TRACKPAD_DIMENSIONS, dimensions,
+				 sizeof(dimensions), HID_FEATURE_REPORT, HID_REQ_GET_REPORT);
+	if (ret != sizeof(dimensions)) {
+		hid_err(hdev, "Neo trackpad D9 dimensions request failed: %d\n", ret);
+		ret = ret < 0 ? ret : -EINVAL;
+		goto close;
+	}
+	ret = neo_tp_parse_dimensions(dimensions, sizeof(dimensions), &dim);
+	if (ret) {
+		hid_err(hdev, "Neo trackpad D9 dimensions invalid\n");
+		goto close;
+	}
+	input = devm_input_allocate_device(&hdev->dev);
+	if (!input) {
+		ret = -ENOMEM;
+		goto close;
+	}
+	tp->input = input;
+	input->name = "Apple Neo Trackpad";
+	input->phys = hdev->phys;
+	input->id.bustype = hdev->bus;
+	input->id.vendor = hdev->vendor;
+	input->id.product = hdev->product;
+	input->id.version = hdev->version;
+	input_set_capability(input, EV_KEY, BTN_LEFT);
+	__set_bit(INPUT_PROP_BUTTONPAD, input->propbit);
+	input_set_abs_params(input, ABS_MT_POSITION_X, dim.min_x, dim.max_x, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_Y, -dim.max_y, -dim.min_y, 0, 0);
+	input_abs_set_res(input, ABS_MT_POSITION_X, dim.res_x);
+	input_abs_set_res(input, ABS_MT_POSITION_Y, dim.res_y);
+	input_set_abs_params(input, ABS_MT_TOUCH_MAJOR, 0, 65534, 0, 0);
+	input_set_abs_params(input, ABS_MT_TOUCH_MINOR, 0, 65534, 0, 0);
+	/* Neo has no force sensor; do not advertise fabricated pressure. */
+	ret = input_mt_init_slots(input, NEO_TRACKPAD_CONTACTS,
+				 INPUT_MT_POINTER | INPUT_MT_DROP_UNUSED | INPUT_MT_TRACK);
+	if (ret)
+		goto close;
+	input_set_events_per_packet(input, 128);
+	ret = input_register_device(input);
+	if (ret)
+		goto close;
+	smp_store_release(&tp->registered, true);
+	hid_info(hdev, "Neo trackpad decoder registered; D9 %ux%u bounds %d..%d/%d..%d resolution %d/%d; report75 enabled\n",
+		 dim.width, dim.height, dim.min_x, dim.max_x, dim.min_y, dim.max_y,
+		 dim.res_x, dim.res_y);
+	return;
+close:
+	hid_err(hdev, "Neo trackpad input registration stopped: %d\n", ret);
+	hid_hw_close(hdev);
+	tp->opened = false;
+}
+
+static int neo_trackpad_probe(struct hid_device *hdev, const struct hid_device_id *id)
+{
+	struct neo_trackpad *tp;
+	struct hid_report *report;
+	int ret;
+
+	if (hdev->type != HID_TYPE_SPI_MOUSE || !hdev->dev.parent ||
+	    !of_device_is_compatible(hdev->dev.parent->of_node, "apple,t8140-dockchannel-hid"))
+		return -ENODEV;
+	tp = devm_kzalloc(&hdev->dev, sizeof(*tp), GFP_KERNEL);
+	if (!tp)
+		return -ENOMEM;
+	tp->hdev = hdev;
+	INIT_WORK(&tp->start_work, neo_trackpad_start_work);
+	hid_set_drvdata(hdev, tp);
+	ret = hid_parse(hdev);
+	if (ret)
+		return ret;
+	/* The real HID descriptor does not advertise this vendor report. */
+	report = hid_register_report(hdev, HID_INPUT_REPORT, NEO_TRACKPAD_REPORT, 0);
+	if (!report)
+		return -ENOMEM;
+	report->size = 0;
+	ret = hid_hw_start(hdev, 0);
+	if (ret)
+		return ret;
+	/* Leave the ordered interface-creation queue free to register the keyboard. */
+	queue_work(system_long_wq, &tp->start_work);
+	return 0;
+}
+
+static void neo_trackpad_remove(struct hid_device *hdev)
+{
+	struct neo_trackpad *tp = hid_get_drvdata(hdev);
+
+	cancel_work_sync(&tp->start_work);
+	smp_store_release(&tp->registered, false);
+	if (tp->opened)
+		hid_hw_close(hdev);
+	hid_hw_stop(hdev);
+}
+
+static const struct hid_device_id neo_trackpad_ids[] = {
+	{ HID_DEVICE(BUS_HOST, NEO_TRACKPAD_HID_GROUP, 0, 0) },
+	{ }
+};
+MODULE_DEVICE_TABLE(hid, neo_trackpad_ids);
+
+static struct hid_driver neo_trackpad_driver = {
+	.name = "neo-trackpad",
+	.id_table = neo_trackpad_ids,
+	.probe = neo_trackpad_probe,
+	.remove = neo_trackpad_remove,
+	.raw_event = neo_trackpad_raw_event,
+	.driver = { .suppress_bind_attrs = true },
+};
+module_hid_driver(neo_trackpad_driver);
+MODULE_LICENSE("Dual MIT/GPL");
+MODULE_DESCRIPTION("Experimental Apple J700 MTP trackpad decoder");
diff --git a/drivers/hid/dockchannel-hid/neo-trackpad.h b/drivers/hid/dockchannel-hid/neo-trackpad.h
new file mode 100644
index 0000000000000000000000000000000000000000..9f1bd86a06432c46ede291a335db71d2044c1583
--- /dev/null
+++ b/drivers/hid/dockchannel-hid/neo-trackpad.h
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _NEO_TRACKPAD_H
+#define _NEO_TRACKPAD_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+
+/* Private group shared only by the experimental Neo transport and decoder. */
+#define NEO_TRACKPAD_HID_GROUP 0xff00
+#define NEO_TRACKPAD_REPORT 0x75
+#define NEO_TRACKPAD_DIMENSIONS 0xd9
+#define NEO_TRACKPAD_CONTACTS 32
+
+struct neo_tp_dimensions {
+	int min_x, max_x, min_y, max_y, res_x, res_y;
+	u32 width, height;
+};
+
+struct neo_tp_contact {
+	int x, y, major, minor;
+};
+
+struct neo_tp_frame {
+	u16 offset, stride;
+	u8 count, active, buttons;
+	struct neo_tp_contact contacts[NEO_TRACKPAD_CONTACTS];
+};
+
+static inline int neo_tp_parse_dimensions(const u8 *data, size_t size,
+				   struct neo_tp_dimensions *dim)
+{
+	u32 x_span, y_span;
+
+	if (size != 17 || data[0] != NEO_TRACKPAD_DIMENSIONS)
+		return -EINVAL;
+	dim->width = get_unaligned_le32(data + 1);
+	dim->height = get_unaligned_le32(data + 5);
+	dim->min_x = (s16)get_unaligned_le16(data + 9);
+	dim->min_y = (s16)get_unaligned_le16(data + 11);
+	dim->max_x = (s16)get_unaligned_le16(data + 13);
+	dim->max_y = (s16)get_unaligned_le16(data + 15);
+	if (!dim->width || !dim->height || dim->min_x >= dim->max_x ||
+	    dim->min_y >= dim->max_y)
+		return -EINVAL;
+	x_span = dim->max_x - dim->min_x;
+	y_span = dim->max_y - dim->min_y;
+	/* Dimensions are hundredths of a millimetre; spans fit signed16 ranges. */
+	dim->res_x = 100 * x_span / dim->width;
+	dim->res_y = 100 * y_span / dim->height;
+	if (!dim->res_x || !dim->res_y)
+		return -EINVAL;
+	return 0;
+}
+
+/* V4 framing follows the working macOS parser, not fixed 38+30N sizing. */
+static inline int neo_tp_parse_frame(const u8 *data, size_t size, struct neo_tp_frame *frame)
+{
+	size_t header, auxiliary, paths, image, extra, offset, stride;
+	unsigned int count, i;
+	u16 flags;
+
+	if (size < 32 || size > 4096 || data[0] != NEO_TRACKPAD_REPORT || data[3] != 4)
+		return -EINVAL;
+	header = data[2];
+	flags = get_unaligned_le16(data + 12);
+	auxiliary = get_unaligned_le16(data + 14);
+	paths = get_unaligned_le16(data + 16);
+	image = get_unaligned_le16(data + 18);
+	extra = get_unaligned_le16(data + 20);
+	count = data[22];
+	if (header < 32 || header > size || (auxiliary != 0 && auxiliary != 6) ||
+	    count > NEO_TRACKPAD_CONTACTS)
+		return -EINVAL;
+	offset = header + auxiliary;
+	/* All operands are bounded u8/u16, and size_t is at least32 bits. */
+	if (offset + paths + image + extra > size)
+		return -EINVAL;
+	if (!count) {
+		if (paths)
+			return -EINVAL;
+		stride = 0;
+	} else {
+		if (!(flags & 2) || !paths || paths % count)
+			return -EINVAL;
+		stride = paths / count;
+		/* macOS supports variable records; we use only the verified prefix. */
+		if (stride < 20 || stride > 64 || stride % 2)
+			return -EINVAL;
+	}
+	frame->offset = offset;
+	frame->stride = stride;
+	frame->count = count;
+	frame->active = 0;
+	frame->buttons = data[23] & 1;
+	for (i = 0; i < count; i++) {
+		const u8 *p = data + offset + i * stride;
+		struct neo_tp_contact *contact;
+		int major = (s16)get_unaligned_le16(p + 18);
+
+		/* As in the established MTP decoder, zero touch area is not contact. */
+		if (major <= 0)
+			continue;
+		contact = &frame->contacts[frame->active++];
+		contact->x = (s16)get_unaligned_le16(p + 4);
+		contact->y = -(int)(s16)get_unaligned_le16(p + 6);
+		contact->major = major * 2;
+		contact->minor = stride >= 22 ? (s16)get_unaligned_le16(p + 20) : major;
+		if (contact->minor < 0)
+			contact->minor = 0;
+		contact->minor *= 2;
+	}
+	return 0;
+}
+#endif
