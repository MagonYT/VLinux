+
+static void apple_dart_t8110_v2_mask_errors(struct apple_dart *dart)
+{
+	writel(U32_MAX, dart->regs + DART_T8110_V2_ERROR_MASK);
+	/* Auxiliary sources have opposite polarity and are not enabled here. */
+	writel(0, dart->regs + dart->neo_aux_enable);
+	readl(dart->regs + DART_T8110_V2_ERROR_MASK);
