+		value = readl(dart->regs + dart->neo_aux_status);
+		writel(value, dart->regs + dart->neo_aux_status);
+		readl(dart->regs + dart->neo_aux_status);
+	}
+
+	if (readl(dart->regs + DART_T8110_V2_DIAG_LOCK) & DART_T8110_V2_LOCK_ON_ERR) {
+		ret = readl_poll_timeout_atomic(dart->regs + DART_T8110_TLB_CMD, value,
