+	/* The active J700 SCMFIFO driver uses a 5000 ms control-report timeout. */
+	ret = dchid_cmd_timeout(iface->dchid->comm, HID_FEATURE_REPORT, REQ_SET_REPORT,
+				cmd, size, NULL, 0, NEO_TRACKPAD_COMMAND_TIMEOUT_MS);
