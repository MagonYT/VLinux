+/* Only the explicitly identified Neo path selects the new fault ABI. */
+static int apple_dart_neo_configure_fault_abi(struct apple_dart *dart, u32 revision,
+					   resource_size_t mmio_size)
+{
+	if (revision == 0x100 || revision == 0x101 ||
+	    revision == 0x200 || revision == 0x201)
+		return 0;
+	if (revision < 0x202 || revision > 0x204)
+		return -EOPNOTSUPP;
+	if (!dart->num_streams || dart->num_streams > DART_MAX_STREAMS ||
+	    mmio_size < DART_T8110_V2_ERROR_RECORD +
+			DART_T8110_V2_ERROR_RECORD_STRIDE * dart->num_streams)
+		return -EINVAL;
+	/* A protected controller needs a separate page-table ownership contract. */
+	if (readl(dart->regs + DART_T8110_PROTECT) & DART_T8110_PROTECT_TTBR_TCR)
+		return -EOPNOTSUPP;
+
+	dart->neo_fault_v2 = true;
+	dart->neo_aux_status = revision >= 0x204 ? 0x4204 : 0x704;
+	dart->neo_aux_enable = revision >= 0x204 ? 0x4200 : 0x700;
+	return 0;
