+static int dchid_validate_reuse_child(struct device *dev, const struct device_node *child)
+{
+	struct property *prop;
+	int len;
+
+	if (!of_find_property(child, "apple,mtp-reuse-only", &len))
+		return 0;
+	if (len)
+		return dev_err_probe(dev, -EINVAL,
+				     "apple,mtp-reuse-only must be a zero-length boolean\n");
+
+	if (!of_device_is_compatible(dev->of_node, "apple,t8140-dockchannel-hid") ||
+	    !of_node_name_eq(child, "multi-touch") ||
+	    !of_device_is_available(child) ||
+	    of_find_property(child, "apple,mtp-upload-firmware", NULL) ||
+	    of_find_property(child, "firmware-name", NULL))
+		return dev_err_probe(dev, -EINVAL,
+				     "Reuse-only requires enabled Neo multi-touch without firmware-name\n");
+
+	for_each_property_of_node(child, prop) {
+		size_t name_len = strlen(prop->name);
+
+		if (!strcmp(prop->name, "gpios") ||
+		    (name_len >= 6 && !strcmp(prop->name + name_len - 6, "-gpios")))
+			return dev_err_probe(dev, -EINVAL,
+					     "Reuse-only trackpad must not configure GPIOs\n");
+	}
+
+	return 1;
+}
+
+static int dchid_validate_upload_child(struct device *dev, const struct device_node *child)
+{
+	struct property *prop;
+	struct device_node *smc;
+	const char *name;
+	int len;
+
+	if (!of_find_property(child, "apple,mtp-upload-firmware", &len))
+		return 0;
+	if (len || !of_device_is_compatible(dev->of_node, "apple,t8140-dockchannel-hid") ||
+	    !of_node_name_eq(child, "multi-touch") || !of_device_is_available(child) ||
+	    of_find_property(child, "apple,mtp-reuse-only", NULL) ||
+	    of_property_read_string(child, "firmware-name", &name) ||
+	    strcmp(name, NEO_TRACKPAD_FW_NAME) ||
+	    of_property_count_u32_elems(child, "apple,smc") != 1)
+		return dev_err_probe(dev, -EINVAL, "Invalid Neo trackpad firmware/power opt-in\n");
+	for_each_property_of_node(child, prop) {
+		size_t name_len = strlen(prop->name);
+
+		if (!strcmp(prop->name, "gpios") ||
+		    (name_len >= 6 && !strcmp(prop->name + name_len - 6, "-gpios")))
+			return dev_err_probe(dev, -EINVAL, "Neo trackpad must not configure GPIOs\n");
+	}
+	smc = of_parse_phandle(child, "apple,smc", 0);
+	if (!smc)
+		return -EINVAL;
+	len = of_device_is_compatible(smc, "apple,t8140-smc") && of_device_is_available(smc);
+	of_node_put(smc);
+	if (!len)
+		return dev_err_probe(dev, -EINVAL, "Neo trackpad requires its guarded SMC provider\n");
+	return 1;
+}
