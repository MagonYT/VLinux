+struct apple_smc *devm_apple_smc_neo_trackpad_get(struct device *consumer,
+					       struct device_node *trackpad)
+{
+	struct platform_device *pdev;
+	struct device_node *node;
+	struct apple_smc *smc;
+
+	if (!consumer || !trackpad || trackpad->parent != consumer->of_node ||
+	    !of_node_name_eq(trackpad, "multi-touch") ||
+	    !of_device_is_available(trackpad) ||
+	    !of_device_is_compatible(consumer->of_node, "apple,t8140-dockchannel-hid"))
+		return ERR_PTR(-ENODEV);
+	node = of_parse_phandle(trackpad, "apple,smc", 0);
+	if (!node)
+		return ERR_PTR(-ENODEV);
+	if (!of_device_is_compatible(node, "apple,t8140-smc") ||
+	    !of_device_is_available(node)) {
+		of_node_put(node);
+		return ERR_PTR(-ENODEV);
+	}
+	pdev = of_find_device_by_node(node);
+	of_node_put(node);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+	device_lock(&pdev->dev);
+	smc = dev_get_drvdata(&pdev->dev);
+	if (!device_is_bound(&pdev->dev) || !smc) {
+		smc = ERR_PTR(-EPROBE_DEFER);
+	} else if (!smc->neo_trackpad || !smc->neo_metadata_ready ||
+		   READ_ONCE(smc->neo_failed)) {
+		smc = ERR_PTR(-ENODEV);
+	} else if (!device_link_add(consumer, &pdev->dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		smc = ERR_PTR(-ENOMEM);
+	}
+	device_unlock(&pdev->dev);
+	/* The managed device link owns supplier/consumer references on success. */
+	put_device(&pdev->dev);
+	return smc;
+}
+EXPORT_SYMBOL_GPL(devm_apple_smc_neo_trackpad_get);
