+int apple_smc_neo_trackpad_power(struct apple_smc *smc, bool on)
+{
+	/* Exact J700 pKW8 pcIO template; only the low 16-bit scalar changes. */
+	u8 payload[8] = { on ? 0 : 1, 0, 1, 0, 0, 0, 0x13, 0 };
+	int ret;
+
+	if (!smc || !smc->neo_trackpad)
+		return -ENODEV;
+	guard(mutex)(&smc->mutex);
+	if (!smc->neo_metadata_ready || READ_ONCE(smc->neo_failed) ||
+	    smc->boot_stage != APPLE_SMC_INITIALIZED)
+		return -ENODEV;
+	/* One OFF then one ON per boot; callers cannot repeatedly cycle power. */
+	if (smc->neo_power_step != (on ? 1 : 0))
+		return -EALREADY;
+	ret = apple_smc_neo_metadata_locked(smc);
+	if (ret)
+		return ret;
+	memcpy_toio(smc->shmem.iomem, payload, sizeof(payload));
+	smc->neo_power_command = true;
+	ret = apple_smc_cmd_locked(smc, SMC_MSG_WRITE_KEY, SMC_KEY(pcIO),
+				   sizeof(payload), 0, NULL);
+	smc->neo_power_command = false;
+	/* AppleSMC _writeMsg checks status only; WRITE ACKs need not echo length. */
+	if (ret < 0) {
+		WRITE_ONCE(smc->neo_failed, true);
+		return ret;
+	}
+	smc->neo_power_step++;
+	/* The active disable sequence waits 50 ms after the acknowledged write. */
+	if (!on)
+		msleep(50);
+	dev_info(smc->dev, "Neo trackpad power %s acknowledged\n", on ? "on" : "off");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_smc_neo_trackpad_power);
