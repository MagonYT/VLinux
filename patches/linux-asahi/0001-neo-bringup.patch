+static int dchid_neo_firmware_valid(const struct firmware *fw)
+{
+	const u8 *p = fw->data;
+	unsigned int i;
+
+	/* Only the independently decoded J700 HIDF v1 layout is supported. */
+	if (fw->size != NEO_TRACKPAD_FW_HEADER + NEO_TRACKPAD_FW_SIZE ||
+	    get_unaligned_le32(p) != FW_MAGIC || get_unaligned_le32(p + 4) != FW_VER ||
+	    get_unaligned_le32(p + 8) != NEO_TRACKPAD_FW_HEADER ||
+	    get_unaligned_le32(p + 12) != NEO_TRACKPAD_FW_SIZE ||
+	    get_unaligned_le32(p + 16) != NEO_TRACKPAD_FW_IFACE_OFFSET ||
+	    p[NEO_TRACKPAD_FW_HEADER + NEO_TRACKPAD_FW_IFACE_OFFSET] != 0)
+		return -EINVAL;
+	for (i = sizeof(struct fw_header); i < NEO_TRACKPAD_FW_HEADER; i++)
+		if (p[i])
+			return -EINVAL;
+	return 0;
+}
